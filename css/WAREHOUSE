.number {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}


@media screen and (max-width: 600px){
  
  .cards {
    display: block
  }
  
  .skill-card h1{
      font-size: 17px;
      margin-bottom: 20px;
  }

  .skill-card h2{
      font-size: 14px;
      font-weight:600;
      margin-top: 10px;
  }
  
  .skill-card svg{
    position: relative;
    width: 200px;
  }
  
  .cover {
    width: 90%;
    height: 50%;
    margin: 0 auto;
  }

  #prevbtn {
    display: none;
  }
  #nextbtn {
    display: none;
  }
  
  .skill-card {
    background-color: #534f4e;
    border-radius: 30px;
    padding: 20px;
    margin: 20px 10px;
    position: relative;
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.5s ease;
    transform: scale(0.8);
    opacity: 0;
  }
  
  .skill-card.in-view {
    transform: scale(1);
    opacity: 1;
  }

}